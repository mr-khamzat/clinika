# Prometheus конфиг для КлиникСеть.
# Поднимается через docker compose -f docker-compose.monitoring.yml --profile metrics up -d
#
# Что собираем:
#   - postgres-exporter (метрики БД: connections, queries, locks, replication-lag)
#   - prometheus self-metrics
#   - clinika-backend (если когда-то добавим /metrics endpoint в FastAPI)

global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    monitor: 'clinika-monitor'

scrape_configs:
  # Prometheus сам себя
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # PostgreSQL метрики
  - job_name: 'postgres'
    static_configs:
      - targets: ['postgres-exporter:9187']

  # Backend метрики (TODO: добавить prometheus-fastapi-instrumentator в backend/)
  # - job_name: 'clinika-backend'
  #   metrics_path: '/metrics'
  #   static_configs:
  #     - targets: ['clinika-backend:8000']
