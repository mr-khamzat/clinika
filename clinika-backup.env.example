# Конфиг резервного копирования КлиникСеть.
# Скопируй в /etc/clinika-backup.env и заполни нужные поля.
# Затем: chmod 600 /etc/clinika-backup.env (содержит секреты!)

# Где хранить локальные копии (по умолчанию /opt/clinika/backups)
BACKUP_DIR=/opt/clinika/backups

# ── Шифрование (рекомендуется) ────────────────────────────────────────────────
# Если задано — все бэкапы шифруются GPG AES256.
# ВАЖНО: запиши пароль в безопасном месте (KeePass/1Password)!
# Без него восстановление НЕВОЗМОЖНО.
ENCRYPT_PASSPHRASE=

# ── Offsite через rclone (Яндекс.Диск, S3, Google Drive и т.д.) ──────────────
# 1. Установи rclone: apt install rclone
# 2. Настрой remote: rclone config
#    Для Яндекс.Диска: type=yandex, авторизация через браузер.
# 3. Тест: rclone ls yandex:
# 4. Раскомментируй переменные ниже:

# RCLONE_REMOTE=yandex
# RCLONE_PATH=clinika-backups
# RCLONE_RETENTION_DAYS=90

# ── Telegram-уведомления о статусе ───────────────────────────────────────────
# 1. Создай бота через @BotFather, скопируй токен.
# 2. Напиши боту /start, узнай свой chat_id через @userinfobot.

# TG_BOT_TOKEN=
# TG_CHAT_ID=
