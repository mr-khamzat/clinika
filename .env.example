# Пароль роли БД. Используется И в DATABASE_URL ниже, И как POSTGRES_PASSWORD
# для контейнера clinika-db / postgres-exporter (docker-compose.*.yml).
# Оба значения ДОЛЖНЫ совпадать. Только [A-Za-z0-9] (иначе сломает парсинг DSN).
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://clinika:CHANGE_ME@clinika-db:5432/clinika
REDIS_URL=redis://clinika-redis:6379
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
QR_SECRET=change-me-qr-secret
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
MINI_APP_URL=https://your-domain.com/clinika
BACKEND_URL=https://your-domain.com/clinika/api
MANAGER_TELEGRAM_IDS=

# TURN/STUN для WebRTC звонков (coturn в режиме use-auth-secret)
# Сгенерировать: openssl rand -hex 32
TURN_HOST=
TURN_PORT=3478
TURN_SECRET=
TURN_TTL=3600

# ─── Web Push (VAPID) — push-нотификации браузеров ───────────────────────────
# Генерация пары ключей (Base64URL без padding):
#   docker compose exec -T clinika-backend python -c "from py_vapid import Vapid; \
#     import base64; v=Vapid(); v.generate_keys(); \
#     from cryptography.hazmat.primitives.serialization import \
#       Encoding, PublicFormat, PrivateFormat, NoEncryption; \
#     pub=v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint); \
#     priv=v.private_key.private_bytes(Encoding.DER, PrivateFormat.PKCS8, NoEncryption()); \
#     print('VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(pub).decode().rstrip('=')); \
#     print('VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(priv).decode().rstrip('='))"
#
# Если ключи не заданы в .env — приложение автоматически сгенерирует пару
# при первом запуске и сохранит в таблицу vapid_keys (бэкап копий не делается!).
# Для production рекомендуется явно задать ключи в .env, чтобы пережить
# пересоздание БД без потери всех подписок.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# subject — mailto: или https:// URL администратора (попадает в JWT-клейм sub)
VAPID_CLAIM_EMAIL=admin@clinikset.ru

# ─── Sentry (Этап 12 ROADMAP) ───
# Без DSN Sentry не инициализируется — приложение работает как раньше.
#
# Где взять DSN:
#   1. Регистрация на https://sentry.io
#   2. Create Project → Python (для backend) и React (для frontend) — два проекта
#   3. Settings → Projects → <project> → Client Keys (DSN) — копируешь URL
#
# Структура DSN:
#   https://<public_key>@o<org_id>.ingest.sentry.io/<project_id>
#
# Пример (заменить на свои значения):
#   SENTRY_DSN=https://abc123def456@o4505123456789012.ingest.sentry.io/4505987654321098
#   VITE_SENTRY_DSN=https://fed987cba654@o4505123456789012.ingest.sentry.io/4505111122223333
#
# Backend (Python sentry-sdk):
SENTRY_DSN=
# Окружение (production / staging / dev) — попадает в теги событий:
SENTRY_ENVIRONMENT=production
# Доля транзакций, которые шлются для performance monitoring (0.0–1.0):
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend (Vite собирает в бандл):
# ВАЖНО: после изменения VITE_SENTRY_DSN нужна пересборка фронтенда:
#   docker compose build --no-cache clinika-frontend && docker compose up -d clinika-frontend
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# ─── Grafana (опц., docker-compose.monitoring.yml --profile metrics) ───
# Пароль администратора Grafana (по умолчанию admin/admin):
GRAFANA_ADMIN_PASSWORD=

# ─── rclone offsite-бэкап (P0 security) ───
# Установка:
#   1. Скопировать шаблон: cp /root/.config/rclone/rclone.conf.template /root/.config/rclone/rclone.conf
#   2. Открыть rclone.conf и заменить ACCESS_KEY/SECRET_KEY на реальные из Yandex Cloud
#   3. Создать bucket: rclone mkdir yandex-cloud:clinika-backups
#   4. Проверка: rclone lsd yandex-cloud:clinika-backups
# ИЛИ интерактивно (выбрать S3 → Other → endpoint storage.yandexcloud.net):
#   rclone config
#
# Имя bucket-а в формате: <remote>:<bucket>/<hostname>
RCLONE_REMOTE=yandex-cloud:clinika-backups/$(hostname)
